# ── Response cache ─────────────────────────────────────────────────────────
# Live/picker frames render from this cache instantly (no flicker/wipe) while the
# actual fetch runs in the BACKGROUND on a longer interval ($GHA_POLL). The
# ticking timers are computed locally each frame, so they never need the network.
# One entry per repo, so a repo list costs one cache file per repo and each is
# refreshed independently.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gha"
cache_file() { printf '%s/%s.json' "$CACHE_DIR" "$(printf '%s' "$1" | cksum | cut -d' ' -f1)"; }
cache_age()  { local m; m=$(file_mtime "$1"); echo $(( $(date +%s) - m )); }
# repo_cache_file REPO — cache path for one repo under the current scope. The v2
# prefix busts entries written when this fetched through `gh run list`, whose
# JSON had different field names.
repo_cache_file() { cache_file "v2|${1}|${all}|${branch}|${limit}"; }
# unstick_lock DIR — both refresh paths lock with mkdir, which a killed job
# leaves behind forever; drop one that's too old to belong to a live fetch.
unstick_lock() {
  if [[ -d "$1" ]] && (( $(cache_age "$1") > 30 )); then rmdir "$1" 2>/dev/null || true; fi
}
# prune_cache — the cache is append-only otherwise: one entry per repo/branch/
# limit combination and one per run ever previewed. Guarded by a daily stamp so
# it costs nothing on the hot path.
prune_cache() {
  local stamp="$CACHE_DIR/.pruned"
  [[ -d "$CACHE_DIR" ]] || return 0
  [[ -f "$stamp" ]] && (( $(cache_age "$stamp") < 86400 )) && return 0
  : > "$stamp" 2>/dev/null || true
  find "$CACHE_DIR" -maxdepth 1 -type f \( -name '*.json' -o -name 'prev-*.txt' \) \
       -mtime +7 -delete 2>/dev/null || true
  find "$CACHE_DIR" -maxdepth 1 -type f \( -name '*.etag' -o -name '*.warn' \) \
       -mtime +7 -delete 2>/dev/null || true
  find "$CACHE_DIR" -maxdepth 1 -type f \( -name '*.tmp' -o -name '*.raw' \
       -o -name '*.body' -o -name '*.err' \) -mtime +1 -delete 2>/dev/null || true
  find "$CACHE_DIR" -maxdepth 1 -type d -name '*.lock' -mtime +1 \
       -exec rmdir {} + 2>/dev/null || true
  return 0
}

# ── Conditional fetch ──────────────────────────────────────────────────────
# The run list comes from `gh api repos/{owner}/{repo}/actions/runs` rather than
# `gh run list`, for one reason: it lets us send If-None-Match. GitHub does not
# charge a 304 against the primary rate limit, so an idle live view polling every
# $GHA_POLL seconds costs essentially nothing, where the unconditional version
# spent 600 requests/hour PER REPO and fell over on a list of eight.
#
# The price is parsing raw REST rather than gh's camelCase mapping: id,
# head_branch, display_title, run_started_at, created_at, updated_at. The
# normalising jq below is the single place that knows those names.

# api_args REPO — `gh api` arguments for one repo's run list. -X GET is required
# because -f alone flips gh to POST; with it, gh URL-encodes the values, which
# matters for branch names carrying a slash or an ampersand.
api_args() {
  local a=(api -i -X GET "repos/$1/actions/runs" -f "per_page=$limit")
  [[ -n "$branch" ]] && a+=(-f "branch=$branch")
  printf '%s\n' "${a[@]}"
}

# _api_fetch REPO FILE — one conditional GET, written atomically.
#   200  body replaces FILE, new ETag stored beside it
#   304  FILE is untouched but its mtime is bumped, so the poll interval resets
#   else FILE is left alone and a warning is queued in FILE.warn
# Returns 0 when FILE holds usable data afterwards, 1 when it does not.
#
# `gh api` exits NON-ZERO on any non-2xx, and that includes the 304 this whole
# design is built on ("gh: HTTP 304" on stderr, exit 1). So the status line from
# -i is read first and the exit code is only consulted afterwards; treating a
# non-zero exit as failure would turn every cache hit into a fetch error.
_api_fetch() {
  local r="$1" f="$2" ef="$2.etag" wf="$2.warn"
  local raw="$2.$$.raw" body="$2.$$.body" err="$2.$$.err"
  local et="" rc=0 st="" newet="" msg line
  local args=(); while IFS= read -r line; do args+=("$line"); done < <(api_args "$r")
  # Only revalidate when there is something to revalidate against: an ETag with
  # no cached body would turn a 304 into no data at all.
  if [[ -s "$f" && -s "$ef" ]]; then
    et="$(cat "$ef" 2>/dev/null || true)"
    [[ -n "$et" ]] && args+=(-H "If-None-Match: $et")
  fi
  rm -f "$wf"
  gh "${args[@]}" > "$raw" 2>"$err" || rc=$?

  # One pass over the response: status line and ETag out on stdout, body to its
  # own file. HTTP/2 lower-cases header names, so match the key case-folded.
  IFS=$'\t' read -r st newet < <(tr -d '\r' < "$raw" 2>/dev/null | awk -v out="$body" '
    NR == 1        { split($0, a, " "); status = a[2]; next }
    body_started   { print > out; next }
    /^[ \t]*$/     { body_started = 1; next }
    {
      key = tolower(substr($0, 1, index($0, ":") - 1))
      if (key == "etag") { et = substr($0, index($0, ":") + 1); sub(/^[ \t]+/, "", et) }
      next
    }
    END { printf "%s\t%s\n", status, et }')

  case "$st" in
    304) rm -f "$raw" "$err" "$body"
         # Bump both: prune_cache ages them out together, and an ETag pruned out
         # from under a live cache file would cost a full response to rebuild.
         touch "$f" "$ef" 2>/dev/null || true; return 0 ;;
    200) if (( rc == 0 )) && [[ -s "$body" ]]; then
           mv -f "$body" "$f"
           [[ -n "$newet" ]] && printf '%s' "$newet" > "$ef" 2>/dev/null || true
           rm -f "$raw" "$err"
           return 0
         fi ;;
  esac

  # A bad token, a missing repo and a dropped network used to be written out as
  # `[]`, i.e. reported as "No runs found" with exit 0. Pass gh's own words on.
  msg="$(grep -v '^[[:space:]]*$' "$err" 2>/dev/null | head -2 | tr '\n' ' ')"
  msg="${msg%"${msg##*[![:space:]]}"}"          # drop the join's trailing space
  msg="${msg:-run list failed (HTTP ${st:-?})}"
  rm -f "$raw" "$err" "$body"
  if [[ -s "$f" ]]; then
    printf 'gha: %s: %s\ngha: %s: showing cached results\n' "$r" "$msg" "$r" > "$wf"
    return 0                                    # stale data beats no data
  fi
  printf 'gha: %s: %s\n' "$r" "$msg" > "$wf"
  return 1
}

# _refresh_bg REPO FILE — same fetch, detached and lock-guarded, for live frames.
_refresh_bg() {
  local lock="$2.lock"
  unstick_lock "$lock"
  if mkdir "$lock" 2>/dev/null; then
    ( _api_fetch "$1" "$2" >/dev/null 2>&1; rmdir "$lock" 2>/dev/null || true ) &
    disown 2>/dev/null || true
  fi
}

# _drain_warnings — print whatever the (possibly parallel) fetches queued.
_drain_warnings() {
  local r w
  for r in "${repos[@]}"; do
    w="$(repo_cache_file "$r").warn"
    [[ -f "$w" ]] && { cat "$w" >&2; rm -f "$w"; }
  done
  return 0
}

# MERGE_JQ — every repo's raw response in, one recency-sorted array of normalised
# records out. This is the only place that knows REST's field names.
# `started` keeps run_started_at with a created_at fallback, which is what the
# duration column measures; `created` stays separate because a queued run's age
# is measured from when it was created, not from when it started.
# shellcheck disable=SC2016  # $r and $lim are jq variables, not shell ones
MERGE_JQ='
[ .[]
  | .repo as $r
  | ((.body.workflow_runs // [])[])
  | { repo:       $r,
      id:         (.id | tostring),
      name:       (if ((.name // "") | length) == 0 then "—" else .name end),
      branch:     (.head_branch // ""),
      status:     (.status // ""),
      conclusion: (.conclusion // ""),
      title:      (.display_title // .name // ""),
      started:    (.run_started_at // .created_at // ""),
      created:    (.created_at // ""),
      updated:    (.updated_at // ""),
      event:      (.event // "") } ]
| sort_by(.created) | reverse | .[0:$lim]'

# _emit_bodies — each repo'"'"'s cached response tagged with the repo it came from,
# one JSON object per line, ready for `jq -s`.
_emit_bodies() {
  local r f i=0
  for r in "${repos[@]}"; do
    printf '{"repo":"%s","body":' "$r"
    if [[ -n "${GHA_DEMO:-}" ]]; then demo_json "$i"
    else f="$(repo_cache_file "$r")"; if [[ -s "$f" ]]; then cat "$f"; else printf 'null'; fi
    fi
    printf '}\n'
    i=$(( i + 1 ))
  done
}

# collect_runs — the merged, normalised, recency-sorted run list for every repo
# in scope. Repos are fetched CONCURRENTLY: serially, a list of eight would stall
# the live view for eight round trips per frame.
collect_runs() {
  if [[ -z "${GHA_DEMO:-}" ]]; then
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    prune_cache
    local ttl="${GHA_POLL:-6}" r f age pids=() p usable=0
    for r in "${repos[@]}"; do
      f="$(repo_cache_file "$r")"
      if [[ -n "${GHA_CACHED:-}" ]]; then
        # Live/picker: serve what is on disk now, refresh behind it. Only a cold
        # cache blocks, and then every repo blocks at once rather than in turn.
        if [[ -s "$f" ]]; then
          age=$(cache_age "$f"); (( age >= ttl )) && _refresh_bg "$r" "$f"
        else
          _api_fetch "$r" "$f" >/dev/null 2>&1 & pids+=($!)
        fi
      else
        if [[ -s "$f" ]] && (( $(cache_age "$f") < 3 )); then continue; fi  # rapid repeats
        _api_fetch "$r" "$f" >/dev/null 2>&1 & pids+=($!)
      fi
    done
    for p in ${pids[@]+"${pids[@]}"}; do wait "$p" || true; done
    _drain_warnings
    for r in "${repos[@]}"; do
      [[ -s "$(repo_cache_file "$r")" ]] && usable=$(( usable + 1 ))
    done
    (( usable > 0 )) || return 1
  fi
  _emit_bodies | jq -s --argjson lim "$limit" "$MERGE_JQ"
}

# ev_abbr EVENT — compact label for the trigger event.
ev_abbr() {
  case "$1" in
    push) echo push ;; pull_request) echo PR ;; schedule) echo cron ;;
    workflow_dispatch) echo man ;; workflow_run) echo chain ;;
    release) echo rel ;; dynamic) echo dyn ;; *) echo "${1:0:5}" ;;
  esac
}

# notify SUBTITLE MESSAGE [URL] — native desktop banner. macOS: terminal-notifier
# (clickable open URL + sound) if present, else osascript. Linux: notify-send.
# Falls back silently to nothing if no notifier is available.
notify() {
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title gha -subtitle "$1" -message "$2" ${3:+-open "$3"} -sound default >/dev/null 2>&1 || true
  elif command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"$2\" with title \"gha\" subtitle \"$1\"" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "gha — $1" "$2" >/dev/null 2>&1 || true
  fi
}

# ── Modes that short-circuit before the run list ───────────────────────────

# Open the real Actions page in a browser.
# There is no Actions page that spans repos, so a list opens one tab per repo.
if $web; then
  opened=0
  for wr in "${repos[@]}"; do
    url="https://github.com/${wr}/actions"
    [[ "$all" == false && -n "$branch" ]] && url+="?query=branch%3A${branch}"
    open_url "$url" || exit $?
    opened=$(( opened + 1 ))
  done
  $multi && echo "${D}opened ${opened} Actions pages${X}"
  exit 0
fi

# PR checks for the current branch's open PR. Always THIS directory's repo: the
# question "what is failing on my PR" has no meaning across a list.
if [[ "$mode" == pr ]]; then
  prrepo="$(local_repo)"; [[ -z "$prrepo" ]] && prrepo="$repo"
  repo_args=(-R "$prrepo")
  pj="$(gh pr view "${repo_args[@]}" --json number,title,url,state,headRefName 2>/dev/null || true)"
  if [[ -z "$pj" ]]; then
    echo "${D}No open PR found for the current branch on ${prrepo}.${X}"; exit 0
  fi
  # shellcheck disable=SC2034  # prstate is read to consume the field, not used
  IFS=$'\t' read -r prnum prtitle prurl prstate < <(echo "$pj" | jq -r '[(.number|tostring),.title,.url,.state]|@tsv')
  hdr="$(hlink "$prurl" "${B}PR #${prnum}${X}")  ${prtitle}"
  echo "$hdr"
  cj="$(gh pr checks "$prnum" "${repo_args[@]}" \
    --json name,state,bucket,link,workflow,startedAt,completedAt 2>/dev/null || true)"
  if [[ -z "$cj" || "$cj" == "[]" ]]; then
    echo "${D}No checks reported yet.${X}"; exit 0
  fi
  # shellcheck disable=SC2034  # cwf consumes the workflow field, which the
  # per-check line does not show; the PR header already names the workflow.
  echo "$cj" | jq -r '.[] | [.bucket,(.name//""),(.workflow//""),(.startedAt//""),(.completedAt//""),(.link//"")] | join("\u001f")' \
  | while IFS=$'\x1f' read -r bucket cname cwf cstart cend clink; do
      case "$bucket" in
        pass)    ic="${G}${I_OK}${X}" ;; fail) ic="${R}${I_BAD}${X}" ;;
        pending) ic="${Y}${I_RUN}${X}" ;; skipping) ic="${D}${I_SKIP}${X}" ;;
        cancel)  ic="${D}${I_CANCEL}${X}" ;; *) ic="${D}?${X}" ;;
      esac
      d=""; [[ -n "$cstart" && -n "$cend" ]] && d="$(dur "$cstart" "$cend")"
      nm="$cname"; [[ -n "$clink" ]] && nm="$(hlink "$clink" "$cname")"
      [[ "$bucket" == fail ]] && nm="${R}${nm}${X}"
      printf '  %b  %s  %b%s%b\n' "$ic" "$nm" "$D" "$d" "$X"
    done
  exit 0
fi

# Cached run preview for the fzf picker. Serves a cached `gh run view` instantly
# (no per-reload network stall = no preview flicker); refreshes in the background.
if [[ "$mode" == preview ]]; then
  if [[ -n "${GHA_DEMO:-}" ]]; then
    printf '%b Production deploy (demo)  %s  run #%s\n\nJOBS\n%b build (12s)\n%b test (3m1s)\n%b deploy (running)\n\n(demo preview %s no real run)\n' \
      "${G}${I_RUN}${X}" "$SEP" "$preview_id" "${G}${I_OK}${X}" "${G}${I_OK}${X}" "${Y}${I_RUN}${X}" "$DASH"; exit 0
  fi
  mkdir -p "$CACHE_DIR" 2>/dev/null || true
  pf="$CACHE_DIR/prev-${preview_id}.txt"; ttl="${GHA_POLL:-6}"
  _gen_preview() { GH_FORCE_TTY="${FZF_PREVIEW_COLUMNS:-80}" gh run view "$preview_id" "${repo_args[@]}" 2>&1; }
  if [[ -f "$pf" ]] && (( $(cache_age "$pf") < ttl )); then
    cat "$pf"
  elif [[ -f "$pf" ]]; then
    cat "$pf"                                    # show cached instantly…
    lock="$pf.lock"                              # …refresh in background
    unstick_lock "$lock"
    if mkdir "$lock" 2>/dev/null; then
      ( _gen_preview > "$pf.bg" 2>/dev/null && mv -f "$pf.bg" "$pf"; rmdir "$lock" 2>/dev/null || true ) &
      disown 2>/dev/null || true
    fi
  else
    _gen_preview | tee "$pf" || true             # cold: fetch + cache
  fi
  exit 0
fi

# fzf header (updated on each reload via transform-header): key hints plus a
# summary of any runs currently being background-watched (Ctrl-W).
if [[ "$mode" == watchheader ]]; then
  # Line 1: live timers for any in-progress runs (recomputed each call so they tick).
  # Cache-only: this is re-run every second by the live ticker, so it must never
  # block on the network. collect_runs still schedules a background refresh when
  # the entry goes stale, on the same $GHA_POLL cadence as the list reload.
  export GHA_CACHED=1
  hjson="$(collect_runs 2>/dev/null || printf '[]')"
  runline=""
  while IFS=$'\x1f' read -r rn rc; do
    [[ -z "$rc" ]] && continue
    runline+="${runline:+   }${I_RUN} ${rn:-run} $(live_elapsed "$rc")"
  done < <(printf '%s' "$hjson" | jq -r '.[] | select(.status=="in_progress") | [.name,.started] | join("\u001f")' 2>/dev/null)
  [[ -n "$runline" ]] && printf '%s\n' "$runline"
  if $multi; then
    printf 'state %s took %s when %s repo %s workflow %s branch %s title\n' \
      "$SEP" "$SEP" "$SEP" "$SEP" "$SEP" "$SEP"
  else
    printf 'state %s took %s when %s workflow %s branch %s title\n' "$SEP" "$SEP" "$SEP" "$SEP" "$SEP"
  fi
  printf '%s open   ^L logs   ^R rerun   ^W watch(bg)   ^P panel   esc quit' "$ENTER"
  wd="$CACHE_DIR/watching"
  if [[ -d "$wd" ]]; then
    items=""
    for f in "$wd"/*; do
      [[ -e "$f" ]] || continue
      wn="$(cut -f1 "$f" 2>/dev/null)"
      items+="${items:+, }${wn:-run} #$(basename "$f")"
    done
    [[ -n "$items" ]] && printf '\n%s watching: %s' "$I_WATCH" "$items"
  fi
  exit 0
fi

# ── Live view: re-render on an interval so running timers visibly tick ──────
# Re-execs this script (without -L) each frame; the in-progress elapsed is
# computed fresh every time, so the seconds advance. Ctrl-C to stop.
# (With -i, live is handled inside the fzf launcher via reload instead.)
if $live && ! $interactive; then
  interval="${GHA_INTERVAL:-1}"
  export GHA_CACHED=1                            # frames render from cache; bg refresh
  # Each frame is captured with $(...), so the child's stdout is a pipe: it would
  # otherwise drop color and hyperlinks and fall back to the default width. We
  # paint to a real terminal, so force all three on for the child.
  export GHA_COLOR=1 GHA_LINKS=1
  $ascii && export GHA_ASCII=1
  # Fix a demo anchor once so child frames share it and the timer advances.
  if [[ -n "${GHA_DEMO:-}" && -z "${GHA_DEMO_START:-}" ]]; then
    GHA_DEMO_START="$(date -u +%s)"; export GHA_DEMO_START
  fi
  sub=(-n "$limit"); $failed_only && sub+=(-f)
  { ! $all && [[ -n "$branch" ]]; } && sub+=("$branch")
  cleanup() { printf '\e[?25h\n'; }             # restore cursor on exit
  trap 'cleanup; exit 0' INT TERM; trap cleanup EXIT
  printf '\e[?25l\e[2J'                          # hide cursor, clear once
  while :; do
    # Build the whole frame first, then paint it in ONE write so the terminal
    # never shows a half-cleared/half-drawn list (no flicker on refresh).
    # Re-read the width every frame so resizing the window reflows the table.
    w="${GHA_WIDTH:-$(stty size </dev/tty 2>/dev/null | awk '{print $2}')}"
    if $multi; then
      frame="$(env -u GHA_REPO GHA_REPOS="${repos[*]}" GHA_WIDTH="$w" "$0" "${sub[@]}" 2>/dev/null || true)"
    else
      frame="$(env -u GHA_REPOS GHA_REPO="$repo" GHA_WIDTH="$w" "$0" "${sub[@]}" 2>/dev/null || true)"
    fi
    footer="${G}${I_RUN}${X} ${D}live ${SEP} every ${interval}s ${SEP} $(date "+%H:%M:%S") ${SEP} Ctrl-C to stop${X}"
    printf '\e[H%s\n%s\e[J' "$frame" "$footer"
    sleep "$interval"
  done
fi

# ── Fetch ──────────────────────────────────────────────────────────────────
if [[ -n "$watch_id" ]]; then
  json='[]'                     # picker Ctrl-W: the run is already identified
else
  json="$(collect_runs)"

  # -f shows only failed/cancelled runs. Narrow the JSON itself rather than
  # skipping rows further down, so the summary counts, the "no runs" message and
  # the table all describe the same set of runs instead of the summary describing
  # every run fetched.
  if $failed_only; then
    json="$(printf '%s' "$json" | jq -c '[ .[] | select((.conclusion // "") |
      IN("failure","cancelled","timed_out","startup_failure","action_required")) ]')"
  fi

  if [[ -z "$json" || "$json" == "[]" ]]; then
    if $watch; then echo "gha: no runs found" >&2; exit 1; fi
    # shellcheck disable=SC2016  # the quotes around $branch are literal, for the reader
    $emit_lines || echo "${D}No runs found${X}${branch:+ for branch '$branch'}."
    exit 0
  fi
fi

# Watch the most recent run in scope; optionally notify on finish. Across a repo
# list "most recent" is the newest run of the merged table, so this reads the
# fetch above rather than issuing a list call of its own.
if $watch; then
  if [[ -n "$watch_id" ]]; then
    id="$watch_id"; wrepo="$repo"
  else
    IFS=$'\x1f' read -r id wrepo < <(printf '%s' "$json" \
      | jq -r '.[0] | [.id,.repo] | join("\u001f")' 2>/dev/null)
  fi
  if [[ -z "$id" ]]; then echo "gha: no runs found" >&2; exit 1; fi
  repo_args=(-R "$wrepo")
  run_url="https://github.com/${wrepo}/actions/runs/${id}"
  if ! $notify; then
    # -w: foreground live view (blocks until the run finishes).
    exec gh run watch "${repo_args[@]}" "$id" --exit-status
  fi
  # -N: detach and watch in the BACKGROUND so the shell returns immediately; a
  # native banner fires when the run finishes. The watcher is a child of this
  # (exiting) process — not the user's shell — so there's no job-control noise;
  # `trap '' HUP` keeps it alive if the terminal is later closed.
  IFS=$'\t' read -r wfname wbranch < <(gh run view "$id" "${repo_args[@]}" \
    --json workflowName,headBranch --jq '[.workflowName,.headBranch]|@tsv' 2>/dev/null)
  # Record a watch marker synchronously so a picker reload shows it immediately;
  # the background watcher removes it when the run finishes.
  mkdir -p "$CACHE_DIR/watching" 2>/dev/null || true
  printf '%s\t%s\t%s' "${wfname:-run}" "${wbranch:-}" "$wrepo" > "$CACHE_DIR/watching/$id" 2>/dev/null || true
  ( trap '' HUP INT
    gh run watch "${repo_args[@]}" "$id" >/dev/null 2>&1 || true
    IFS=$'\t' read -r cc wf hb cs cu < <(gh run view "$id" "${repo_args[@]}" \
      --json conclusion,workflowName,headBranch,createdAt,updatedAt \
      --jq '[.conclusion,.workflowName,.headBranch,.createdAt,.updatedAt]|@tsv' 2>/dev/null)
    ran=""; [[ -n "$cs" && -n "$cu" ]] && ran=" in $(dur "$cs" "$cu")"
    rm -f "$CACHE_DIR/watching/$id" 2>/dev/null || true
    case "$cc" in
      success) notify "${I_OK} ${wf:-run} passed${ran}"       "${wrepo} ${SEP} ${hb:-?}" "$run_url" ;;
      *)       notify "${I_BAD} ${wf:-run} ${cc:-failed}${ran}" "${wrepo} ${SEP} ${hb:-?}" "$run_url" ;;
    esac
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
  what="$(hlink "$run_url" "${Y}${wfname:-run} #${id}${X}")"
  echo "${I_WAIT} watching ${what} ${D}${SEP} ${wbranch:-${ELL}}${X}"
  echo "${D}   background ${DASH} you'll get a notification when it finishes  (\`gha -w\` to watch it live)${X}"
  exit 0
fi


# ── Interactive picker (fzf) ───────────────────────────────────────────────
# The list is produced by re-invoking this script in --fzf-lines mode, so fzf can
# reload it: with -L it auto-refreshes on an interval (running timers tick).
if $interactive && ! $emit_lines; then
  if ! command -v fzf >/dev/null 2>&1; then
    echo "gha: interactive mode needs fzf — install it (brew install fzf, apt install fzf, …)" >&2
    exit 1
  fi
  poll="${GHA_POLL:-6}"
  if [[ -n "${GHA_DEMO:-}" && -z "${GHA_DEMO_START:-}" ]]; then
    GHA_DEMO_START="$(date -u +%s)"; export GHA_DEMO_START
  fi
  # Two prefixes. Children that render the LIST inherit the whole scope; children
  # that act on one ROW (preview, Ctrl-W) take that row's repo from field 2,
  # which fzf shell-quotes for us and repo_ok has already restricted to
  # owner/repo. Field 1 is the run id, field 2 the repo, both hidden by
  # --with-nth=3.. and reachable from the binds as {1} and {2}.
  aux_pfx=""; $ascii && aux_pfx+=" GHA_ASCII=1"
  [[ -n "${GHA_DEMO:-}" ]] && aux_pfx+=" GHA_DEMO=1${GHA_DEMO_START:+ GHA_DEMO_START=${GHA_DEMO_START}}"
  if $multi; then scope_pfx="GHA_REPOS='${repos[*]}'"; else scope_pfx="GHA_REPO=${repo}"; fi
  env_pfx="${scope_pfx}${aux_pfx}"
  row_pfx="GHA_REPO={2}${aux_pfx}"
  lines_cmd="${env_pfx} GHA_CACHED=1 ${0} --fzf-lines -n ${limit}"
  $failed_only && lines_cmd+=" -f"
  { ! $all && [[ -n "$branch" ]]; } && lines_cmd+=" ${branch}"
  preview="${row_pfx} ${0} --preview-run {1}"           # cached preview → no flicker
  hdr_env="${env_pfx}"; $live && hdr_env+=" GHA_LIVE=1"
  hdr_cmd="${hdr_env} ${0} --watch-header"
  # `load` fires after each (re)load: refresh the header (watch summary), and when
  # live schedule the next reload-sync on the NETWORK-poll cadence — not per second,
  # so the preview pane isn't re-run constantly (that was the flicker).
  # Live design: a background ticker POSTs a header refresh to fzf every second
  # via --listen (so the running-job timer ticks WITHOUT reloading the list — no
  # preview flicker), and reloads the list on the slower $GHA_POLL cadence. If
  # curl/--listen isn't usable, fall back to a plain load-loop reload.
  extra=(); ticker=""; portf=""
  use_listen=false
  if $live && command -v curl >/dev/null 2>&1; then use_listen=true; fi

  if $use_listen; then
    extra=(--track --listen)
    portf="$(mktemp "${TMPDIR:-/tmp}/gha.XXXXXX")"; : > "$portf"
    start_act="execute-silent(printf '%s' \"\$FZF_PORT\" > ${portf})+reload(${lines_cmd})+transform-header(${hdr_cmd})"
    load_act="transform-header(${hdr_cmd})"
    ( trap 'exit 0' TERM INT
      p=""; for _ in $(seq 1 60); do p="$(cat "$portf" 2>/dev/null)"; [[ -n "$p" ]] && break; sleep 0.1; done
      [[ -z "$p" ]] && exit 0
      tick=0
      while :; do
        curl -s -XPOST "localhost:${p}" --data-binary "transform-header(${hdr_cmd})" >/dev/null 2>&1 || exit 0
        tick=$(( tick + 1 ))
        (( tick % poll == 0 )) && curl -s -XPOST "localhost:${p}" --data-binary "reload-sync(${lines_cmd})" >/dev/null 2>&1
        sleep 1
      done ) & ticker=$!
    disown 2>/dev/null || true
  else
    start_act="reload(${lines_cmd})+transform-header(${hdr_cmd})"
    load_act="transform-header(${hdr_cmd})"
    if $live; then extra=(--track); load_act+="+reload-sync(sleep ${poll}; ${lines_cmd})"; fi
  fi

  fzf_ascii=(); $ascii && fzf_ascii=(--no-unicode)
  fzf < /dev/null \
    --ansi --delimiter=$'\t' --with-nth=3.. \
    ${fzf_ascii[@]+"${fzf_ascii[@]}"} \
    --layout=reverse --border=rounded --info=inline --height=100% --cycle --scroll-off=3 \
    --prompt="${scope_label} ${PTR} " --pointer="$PICK" --border-label=" gha ${SEP} ${scope_label} " \
    --header="${ENTER} open   ^L logs   ^R rerun   ^W watch(bg)   ^P panel   esc quit" \
    --preview="$preview" --preview-label=' run detail ' \
    --preview-window='right,52%,border-left,wrap,<100(down,60%,border-top,wrap)' \
    ${extra[@]+"${extra[@]}"} \
    --bind="start:${start_act}" \
    --bind="load:${load_act}" \
    --bind="enter:execute-silent(gh run view {1} -R {2} --web)" \
    --bind="ctrl-l:execute(gh run view {1} -R {2} --log-failed 2>&1 | less -R)" \
    --bind="ctrl-r:execute(gh run rerun {1} -R {2} --failed 2>&1 | less -R)" \
    --bind="ctrl-w:execute-silent(${row_pfx} ${0} --watch-id {1})+reload-sync(${lines_cmd})+transform-header(${hdr_cmd})+bell" \
    --bind="ctrl-o:execute-silent(gh run view {1} -R {2} --web)" \
    --bind="ctrl-p:toggle-preview" \
    --bind="alt-w:change-preview-window(down,65%,border-top,wrap|hidden|right,52%,border-left,wrap)" \
    || true
  [[ -n "$ticker" ]] && kill "$ticker" 2>/dev/null
  [[ -n "$portf" ]] && rm -f "$portf"
  exit 0
fi

# ── Header + summary (skipped in interactive mode) ─────────────────────────
if ! $interactive; then
  read -r ok fail run queue canc latest < <(echo "$json" | jq -r '
    [ (map(select(.conclusion=="success"))|length),
      (map(select(.conclusion|IN("failure","timed_out","startup_failure")))|length),
      (map(select(.status=="in_progress"))|length),
      (map(select(.status|IN("queued","waiting","requested","pending")))|length),
      (map(select(.conclusion=="cancelled"))|length),
      ([.[].updated]|max) // "-" ] | @tsv')

  if $multi; then scope="${B}${scope_label}${X}"
  else scope="$(hlink "$actions_url" "${B}${repo}${X}")"; fi
  ! $all && scope+=" ${D}${DASH} ${branch}${X}"
  sum="${G}${I_OK} ${ok}${X}  ${R}${I_BAD} ${fail}${X}"
  (( run   > 0 )) && sum+="  ${Y}${I_RUN} ${run}${X}"
  (( queue > 0 )) && sum+="  ${Y}${I_QUEUE} ${queue}${X}"
  (( canc  > 0 )) && sum+="  ${D}${I_CANCEL} ${canc}${X}"
  upd=""; [[ "$latest" != "-" ]] && upd="  ${D}${SEP} updated $(rel "$latest") ago${X}"
  echo "${scope}   ${sum}${upd}"

  # Terminal width for responsive columns. `stty size </dev/tty` reads the real
  # window even inside command substitution (tput cols can't — fd 1 is a pipe
  # there). GHA_WIDTH overrides (handy for testing / fixed-width output).
  termw="${GHA_WIDTH:-}"
  [[ -z "$termw" && -t 1 ]] && termw=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
  [[ "$termw" =~ ^[0-9]+$ ]] || termw=88
  (( termw < 40 )) && termw=88
  # Cap how wide the table lays out. Rows right-pin their times to this width and
  # the rule spans exactly the same width, so the divider matches the rows (no
  # overhang) and ultra-wide windows don't open a huge title→time void. Override
  # with GHA_MAXWIDTH; the responsive column choices below still use the real termw.
  # A repo column adds ~20 columns of left cluster, so a list is given more room
  # to lay out in before the cap bites; otherwise the title would be squeezed to
  # nothing on exactly the windows wide enough to show every column.
  maxw="${GHA_MAXWIDTH:-}"
  if [[ -z "$maxw" ]]; then if $multi; then maxw=120; else maxw=100; fi; fi
  loutw=$termw; (( loutw > maxw )) && loutw=$maxw
  rule=$(printf '%*s' "$loutw" ''); echo "${D}${rule// /$RULE}${X}"

  # Responsive column plan. Layout is space-between: a left cluster (icon + repo
  # + workflow + branch + event), a flex title, and a right-pinned meta block
  # (duration + age). Columns drop as the window narrows.
  #
  # Single repo, unchanged: event → workflow → branch.
  # A repo list drops REPO LAST — it is the column that says which repo a row
  # belongs to, so a table that has dropped it is not a multi-repo table any
  # more. Workflow and event pay for it instead, and only reappear on a window
  # wide enough to carry both: event → workflow → branch → repo.
  # `Lw` is the visible width of the left cluster incl. gaps.
  show_wf=1; show_ev=1; show_dur=1; show_br=1; show_repo=0
  $multi && show_repo=1
  $all || show_br=0
  (( termw < 68 )) && show_dur=0
  (( termw < 50 )) && show_br=0
  if (( show_repo )); then
    (( termw < 112 )) && show_ev=0
    (( termw < 104 )) && show_wf=0
    (( termw < 44 ))  && show_repo=0
  else
    (( termw < 96 )) && show_ev=0
    (( termw < 74 )) && show_wf=0
  fi
  wf_w=13; ev_w=5
  br_w=20; (( termw < 90 )) && br_w=16
  repo_w=18; (( termw < 96 )) && repo_w=16
  recalc_Lw() {
    Lw=1
    (( show_repo )) && Lw=$(( Lw + 2 + repo_w ))
    (( show_wf ))   && Lw=$(( Lw + 2 + wf_w ))
    (( show_br ))   && Lw=$(( Lw + 2 + br_w ))
    (( show_ev ))   && Lw=$(( Lw + 2 + ev_w ))
    return 0
  }
  recalc_Lw

  # Guard rail. The thresholds above are a PREFERENCE; this is the arithmetic.
  # A row is 2 + left cluster + 2 + title + gap + meta, and the gap is clamped to
  # a minimum of 1, so the row only lands exactly on loutw while
  #   loutw >= 5 + Lw + title + meta.
  # Keep dropping columns, in the same order, until that holds for the widest
  # title and meta block a row can produce.
  # Without this, adding a column (the repo one did exactly this at width 50)
  # silently produces rows that overhang the rule — which the width invariant in
  # tests/ then fails on, loudly, rather than shipping a crooked table.
  MIN_TITLE=10                       # the floor `avail` clamps to below
  while :; do
    meta_max=7; (( show_dur )) && meta_max=16    # "queued 365d ago" is the widest
    (( 5 + Lw + MIN_TITLE + meta_max <= loutw )) && break
    if   (( show_ev ));   then show_ev=0
    elif (( show_wf ));   then show_wf=0
    elif (( show_dur ));  then show_dur=0
    elif (( show_br ));   then show_br=0
    elif (( show_repo )); then show_repo=0
    else break
    fi
    recalc_Lw
  done

  # Dim column-label row so the table reads without prior knowledge. Lists only
  # the columns actually shown at this width, left→right. Suppress with --bare or
  # GHA_NOHEADER=1 for the terse everyday view.
  if ! $bare && [[ -z "${GHA_NOHEADER:-}" ]]; then
    leg="state"
    (( show_repo )) && leg+=" ${SEP} repo"
    (( show_wf ))   && leg+=" ${SEP} workflow"
    (( show_br )) && leg+=" ${SEP} branch"
    (( show_ev )) && leg+=" ${SEP} event"
    leg+=" ${SEP} title"
    (( show_dur )) && leg+=" ${SEP} took"
    leg+=" ${SEP} when"
    echo "${D}${leg}${X}"
  fi
fi

# ── Rows ───────────────────────────────────────────────────────────────────
# rows delimited by unit separator (\x1f) so empty fields don't collapse.
while IFS=$'\x1f' read -r rrepo id name hbranch status conclusion title started created updated event; do
  case "$status" in
    completed)
      case "$conclusion" in
        success)                             icon="${G}${I_OK}${X}"; dur_p="$(dur "$started" "$updated")" ;;
        failure|timed_out|startup_failure)   icon="${R}${I_BAD}${X}"; dur_p="$(dur "$started" "$updated")" ;;
        cancelled)                           icon="${D}${I_CANCEL}${X}"; dur_p="$(dur "$started" "$updated")" ;;
        skipped)                             icon="${D}${I_SKIP}${X}"; dur_p="" ;;
        action_required)                     icon="${Y}!${X}"; dur_p="" ;;
        *)                                   icon="${D}?${X}"; dur_p="" ;;
      esac
      age_p="$(rel "$updated") ago"; metacol="" ;;
    in_progress) icon="${Y}${I_RUN}${X}"; dur_p="$(live_elapsed "$started")"; age_p=""; metacol="$Y" ;;
    queued|waiting|requested|pending) icon="${Y}${I_QUEUE}${X}"; dur_p="queued"; age_p="$(rel "$created") ago"; metacol="$Y" ;;
    *) icon="${D}?${X}"; dur_p="$status"; age_p=""; metacol="$D" ;;
  esac
  ev="$(ev_abbr "$event")"

  # Failure-forward: tint the whole row (name/branch/event/title) red for hard
  # failures so they pop among a wall of green checks. Others keep periwinkle/cyan.
  tint=""; brc="$P"; evc="$C"
  case "$conclusion" in
    failure|timed_out|startup_failure) tint="$R"; brc="$R"; evc="$R" ;;
  esac

  # Interactive: collect id-prefixed colored lines for fzf (no hyperlinks; fzf
  # binds handle opening). id is field 1, hidden via --with-nth.
  if $interactive; then
    # Fit the narrow list pane: age first (always visible), title last so fzf
    # truncates IT at the edge, not the age/branch. Full detail is in the preview.
    # Two time columns: duration (how long it took) + age (when it ran). A running
    # run shows its live ticking elapsed as the duration, with no age yet.
    case "$status" in
      completed)   dcol="$(dur "$started" "$updated")"; acol="$(rel "$updated") ago" ;;
      in_progress) dcol="$(live_elapsed "$started")";   acol="" ;;
      *)           dcol="";                              acol="$(rel "$created") ago" ;;
    esac
    dcell "$hbranch" 14 "$ELL"; lbr="$D_S"
    dcell "$name" 8; lwf="$D_S"
    rcell=""
    if $multi; then dcell "$rrepo" 18 "$ELL"; rcell=" ${B}${D_S}${X}"; fi
    wmark=""; [[ -e "$CACHE_DIR/watching/$id" ]] && wmark=" ${M}${I_WATCH}${X}"   # being watched
    printf -v disp '%b %b%6s%b %b%8s%b %b %b%s%b %b%s%b %b%s%b%s' \
      "$icon" "$C" "$dcol" "$X" "$D" "$acol" "$X" "$rcell" "$tint" "$lwf" "$X" "$brc" "$lbr" "$X" "$tint" "$title" "$X" "$wmark"
    # Fields 1 and 2 (id, repo) are hidden by --with-nth=3.. and are what the
    # binds act on, so every row carries the repo it actually came from.
    printf '%s\t%s\t%s\n' "$id" "$rrepo" "$disp"
    continue
  fi

  # Build the left cluster (icon + visible columns), each padded to its width.
  run_url="https://github.com/${rrepo}/actions/runs/${id}"
  left="$icon"
  if (( show_repo )); then
    dcell "$rrepo" "$repo_w" "$ELL"
    left+="  $(hlink "https://github.com/${rrepo}/actions" "${B}${D_S}${X}")"
  fi
  if (( show_wf )); then
    dcell "$name" "$wf_w"                     # hard cut: workflow names repeat
    left+="  $(hlink "$run_url" "${tint}${D_S}${X}")"
  fi
  if (( show_br )); then
    dcell "$hbranch" "$br_w" "$ELL"
    left+="  ${brc}${D_S}${X}"
  fi
  if (( show_ev )); then
    dcell "$ev" "$ev_w"
    left+="  ${evc}${D_S}${X}"
  fi

  # Meta block (duration + age), right-pinned. Measure the plain text so the
  # ANSI/hyperlink bytes don't throw off the padding math. Duration drops first.
  if (( show_dur )) && [[ -n "$dur_p" ]]; then
    meta_plain="${dur_p} ${age_p}"; meta_col="${metacol}${dur_p}${X} ${D}${age_p}${X}"
  else
    meta_plain="${age_p}"; meta_col="${D}${age_p}${X}"
  fi
  dfit "$meta_plain"; metalen=$D_W

  # Flex title fills the gap; the meta block sits flush at the right edge of the
  # capped layout width (loutw), so times stay column-aligned without sprawling.
  avail=$(( loutw - 2 - Lw - 3 - metalen )); (( avail < MIN_TITLE )) && avail=$MIN_TITLE
  (( avail > 100 )) && avail=100
  dtrunc "$title" "$avail" "$ELL"; t="$D_S"; tw=$D_W
  tcell="$(hlink "$run_url" "${tint}${t}${X}")"
  # tw, not $avail: dtrunc reports what it actually kept, which is a column
  # short of the budget whenever a two-column character straddled the edge.
  pad=$(( loutw - 2 - Lw - 2 - tw - metalen )); (( pad < 1 )) && pad=1
  printf -v gap '%*s' "$pad" ''
  printf '  %s  %s%s%s\n' "$left" "$tcell" "$gap" "$meta_col"
done < <(echo "$json" | jq -r '.[] |
  [ .repo, .id, .name, .branch, .status, .conclusion,
    .title, .started, .created, .updated, .event ] | join("\u001f")')
