#!/usr/bin/env bash
# gha — fast GitHub Actions status for the current repo.
#
# Mirrors the repo's Actions page: latest runs across ALL branches by default.
# Run names/titles are Cmd-clickable (open the run on GitHub) in modern terminals.
#
# Usage:
#   gha            latest runs across ALL branches (the Actions page)
#   gha -i         interactive picker (fzf): preview jobs, open, logs, rerun
#   gha -L         live view: timers tick every $GHA_INTERVAL (1s) from cache;
#                  network refresh every $GHA_POLL (6s) in the background
#   gha pr         checks for the current branch's open PR
#   gha -b         only the CURRENT git branch
#   gha <branch>   only a specific branch
#   gha -f         only failed/cancelled runs
#   gha -n N       show N runs (default 15)
#   gha -w         watch newest run live in the FOREGROUND (blocks)
#   gha -N         watch newest run in the BACKGROUND + notify on finish
#   gha --web      open the Actions page in a browser
#   gha --bare     hide the dim column-label header row
#   gha --demo     preview the UX with synthetic data (try: gha --demo -L, -i -L)
#   gha --ascii    plain ASCII marks, for fonts with no symbol coverage
#
# Repo: $GHA_REPO, else the `upstream`/`origin` remote of the current repo,
# else whatever `gh` resolves for this directory. Requires: gh, jq (fzf for -i).

set -euo pipefail

die()  { printf 'gha: %s\n' "$1" >&2; exit "${2:-1}"; }
# need CMD HINT — hard-fail with a useful message instead of the empty result
# that a missing dependency used to produce.
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed${2:+ $2}"; }
# usage — the header comment block, printed as help. Reads until the first
# non-comment line rather than a fixed line range, so editing the header (or
# adding a flag to it) can't truncate the help or leak code into it.
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }

limit=15
branch=""
all=true
watch=false
failed_only=false
web=false
interactive=false
live=false
notify=false
mode=runs
watch_id=""
preview_id=""
emit_lines=false
bare=false
ascii=false

# Subcommand: `gha pr` shows the current branch's PR checks.
[[ "${1:-}" == "pr" ]] && { mode=pr; shift; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--branch|--mine) all=false; shift ;;
    -a|--all)    all=true; shift ;;
    -i|--interactive) interactive=true; shift ;;
    -L|--live)   live=true; shift ;;
    --demo)      export GHA_DEMO=1; shift ;;   # synthetic data to preview the UX
    --fzf-lines) emit_lines=true; interactive=true; shift ;;  # internal: emit picker rows
    -w|--watch)  watch=true; shift ;;
    -N|--notify) notify=true; watch=true; shift ;;
    --watch-id)  watch_id="${2:?}"; notify=true; watch=true; shift 2 ;;  # internal: picker Ctrl-W
    --preview-run) mode=preview; preview_id="${2:?}"; shift 2 ;;         # internal: cached preview
    --watch-header) mode=watchheader; shift ;;                           # internal: fzf header
    -f|--failed) failed_only=true; shift ;;
    -n)          limit="${2:?-n needs a number}"; shift 2 ;;
    --web)       web=true; shift ;;
    --bare)      bare=true; shift ;;         # hide the column-label header line
    --ascii)     ascii=true; shift ;;        # plain marks for symbol-less fonts
    -h|--help)   usage; exit 0 ;;
    -*)          echo "gha: unknown flag $1" >&2; exit 2 ;;
    *)           branch="$1"; all=false; shift ;;
  esac
done

# Dependencies. jq parses every code path including --demo; gh is only skipped
# for --demo, which serves synthetic data. Checked after option parsing so -h
# still works on a machine with neither installed.
need jq "(https://jqlang.github.io/jq/)"
[[ -n "${GHA_DEMO:-}" ]] || need gh "(https://cli.github.com)"
[[ "$limit" =~ ^[0-9]+$ ]] || die "-n takes a number, got '$limit'" 2

if ! $all && [[ -z "$branch" ]]; then
  branch="$(git branch --show-current 2>/dev/null || true)"
fi

# owner/repo from a named remote's URL (git@, https://, ssh://); empty if absent.
# `|| true` keeps a missing remote from tripping `set -o pipefail`.
parse_remote() {
  { git remote get-url "$1" 2>/dev/null || true; } \
    | sed -E 's#^(git@[^:]+:|https?://[^/]+/|ssh://[^/]+/)##; s#\.git$##'
}

# Resolve which repo to query. Prefer $GHA_REPO, then the fork-workflow-canonical
# `upstream` remote, then `origin`, then whatever gh resolves for this directory.
repo="${GHA_REPO:-}"
[[ -z "$repo" ]] && repo="$(parse_remote upstream)"
[[ -z "$repo" ]] && repo="$(parse_remote origin)"
[[ -z "$repo" ]] && repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
[[ -z "$repo" && -n "${GHA_DEMO:-}" ]] && repo="demo/repo"
if [[ -z "$repo" ]]; then
  echo "gha: no repo found — run inside a git repo or set GHA_REPO=owner/repo" >&2
  exit 1
fi
repo_args=(-R "$repo")
actions_url="https://github.com/${repo}/actions"

# ── Portability shims (Linux + macOS) ──────────────────────────────────────
# BSD (macOS) and GNU (Linux) diverge on date/stat flags and the URL opener.
# Detect the date flavor once (BSD date has no --version, so it fails here),
# then route every platform-specific call below through these wrappers.
if date --version >/dev/null 2>&1; then _date=gnu; else _date=bsd; fi

# iso_to_epoch ISO — UTC timestamp ("…Z") to epoch seconds; 0 on failure.
iso_to_epoch() {
  if [[ "$_date" == gnu ]]; then date -u -d "$1" +%s 2>/dev/null || echo 0
  else date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null || echo 0; fi
}
# epoch_to_iso SECONDS — epoch seconds to a UTC "…Z" timestamp.
epoch_to_iso() {
  if [[ "$_date" == gnu ]]; then date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
  else date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ; fi
}
# file_mtime FILE — mtime as epoch seconds (try GNU stat, then BSD); 0 if gone.
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
# open_url URL — open in the default browser (macOS `open`, else `xdg-open`).
open_url() {
  if   command -v open     >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1"
  else echo "gha: no URL opener found (install xdg-utils)" >&2; return 1; fi
}

# ── Presentation helpers ───────────────────────────────────────────────────
# Colors when writing to a terminal — or when emitting fzf list lines (piped to
# fzf, which renders them via --ansi). OSC 8 hyperlinks only on a real terminal.
# Color decision: NO_COLOR disables it (the de-facto standard); FORCE_COLOR /
# CLICOLOR_FORCE / GHA_COLOR force it on (e.g. through a pipe); otherwise it's on
# for a terminal, or when emitting fzf list lines (rendered via --ansi).
# GHA_LINKS likewise forces OSC 8 hyperlinks on: live view captures a child frame
# through a pipe but paints it to a real terminal, so links still resolve.
_color=false
if [[ -n "${NO_COLOR:-}" ]]; then _color=false
elif [[ -n "${FORCE_COLOR:-}${CLICOLOR_FORCE:-}${GHA_COLOR:-}" ]] || [[ -t 1 ]] || $emit_lines; then _color=true
fi
if $_color; then
  G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; C=$'\e[36m'; M=$'\e[35m'; D=$'\e[90m'; B=$'\e[1m'; X=$'\e[0m'
  # P — a soft periwinkle for branch names, so they read as their own column
  # instead of blending into the dim gray used for timestamps and rules.
  P=$'\e[38;5;110m'
else
  G=""; R=""; Y=""; C=""; M=""; D=""; B=""; X=""; P=""
fi
use_links=false
{ [[ -t 1 ]] || [[ -n "${GHA_LINKS:-}" ]]; } && use_links=true

# ── Display width (terminal columns) ───────────────────────────────────────
# The table lays out in COLUMNS, which is neither the byte length of a string
# nor its character count: CJK, kana, Hangul and most emoji occupy two columns,
# and combining marks and variation selectors occupy none — so "⚠️" (U+26A0 plus
# VS16) is one column, not two. bash's ${#s} counts characters under a UTF-8
# locale and BYTES under LC_ALL=C/POSIX, so it is the wrong answer either way.
#
# Every helper below opens with `local LC_ALL=C`, which makes bash index the
# string byte by byte whatever the caller's locale is, and decodes UTF-8 by
# hand. That gives ONE code path with identical results under every locale, and
# costs no fork: calling out to python or perl once per cell would cost more
# than the entire render. Results come back in the globals D_W (columns) and
# D_S (string) rather than on stdout, because $(...) per cell is a subshell per
# cell. tests/helpers_test.sh exercises all of this against python's
# unicodedata, under both LC_ALL=POSIX and a UTF-8 locale.
#
# The width table is a documented SUBSET of wcwidth, chosen to cover what turns
# up in branch names and commit titles, not all of Unicode:
#   zero  combining diacriticals (and their extended/supplement blocks),
#         Cyrillic/Hebrew/Arabic/Thai/Lao combining marks, the zero-width and
#         bidi format controls, the CJK and kana combining marks, variation
#         selectors, combining half marks, U+FEFF, and the tag and variation
#         selector supplement blocks on plane 14.
#   two   Hangul Jamo, the wide symbol and dingbat codepoints, the CJK blocks
#         and their compatibility forms, kana, Bopomofo, Yi, Hangul syllables,
#         fullwidth forms, Tangut, the emoji and pictograph blocks, and the
#         CJK ideograph planes.
# Everything else is one column, East Asian Ambiguous included — which is what
# a terminal on a Western locale actually draws.

# _dwalk STR LIMIT — walk STR one codepoint at a time, setting:
#   D_W     total display width of STR, in columns
#   D_CUT   byte offset of the last codepoint boundary at or before LIMIT columns
#   D_CUTW  width in columns of STR up to D_CUT
# LIMIT < 0 measures only. Malformed UTF-8 is consumed one byte at a time as
# U+FFFD so a bad string still terminates instead of running off the end.
_dwalk() {
  local LC_ALL=C s="$1" lim="$2" len i=0 k b cp n w cut_done=0
  D_W=0; D_CUT=0; D_CUTW=0
  len=${#s}
  # Fast path. Printable ASCII is one byte per column and never straddles a cut,
  # which is the overwhelming majority of workflow names, branches and titles.
  case "$s" in
    *[!\ -~]*) ;;
    *) D_W=$len
       if (( lim >= 0 && lim < len )); then D_CUT=$lim; D_CUTW=$lim
       else D_CUT=$len; D_CUTW=$len; fi
       return 0 ;;
  esac
  while (( i < len )); do
    printf -v b '%d' "'${s:i:1}"; (( b < 0 )) && b=$(( b + 256 ))
    if   (( b < 0x80 )); then cp=$b;              n=1
    elif (( b < 0xC2 )); then cp=0xFFFD;          n=1   # stray continuation byte
    elif (( b < 0xE0 )); then cp=$(( b & 0x1F )); n=2
    elif (( b < 0xF0 )); then cp=$(( b & 0x0F )); n=3
    elif (( b < 0xF5 )); then cp=$(( b & 0x07 )); n=4
    else                      cp=0xFFFD;          n=1   # invalid lead byte
    fi
    if (( n > 1 )); then
      if (( i + n > len )); then cp=0xFFFD; n=1         # sequence cut short
      else
        k=1
        while (( k < n )); do
          printf -v b '%d' "'${s:i+k:1}"; (( b < 0 )) && b=$(( b + 256 ))
          cp=$(( (cp << 6) | (b & 0x3F) )); k=$(( k + 1 ))
        done
      fi
    fi

    # Zero first, then wide: some zero-width marks (U+302A–U+302D, U+3099–U+309A)
    # sit inside blocks that are otherwise wide.
    w=1
    if (( cp < 0x0300 )); then :
    elif (( (cp >= 0x0300 && cp <= 0x036F) || (cp >= 0x0483 && cp <= 0x0489) ||
            (cp >= 0x0591 && cp <= 0x05BD) || cp == 0x05BF ||
            (cp >= 0x05C1 && cp <= 0x05C2) || (cp >= 0x05C4 && cp <= 0x05C5) ||
            cp == 0x05C7 || (cp >= 0x0600 && cp <= 0x0605) ||
            (cp >= 0x0610 && cp <= 0x061A) || cp == 0x061C ||
            (cp >= 0x064B && cp <= 0x065F) || cp == 0x0670 ||
            (cp >= 0x06D6 && cp <= 0x06DD) || (cp >= 0x06DF && cp <= 0x06E4) ||
            (cp >= 0x06E7 && cp <= 0x06E8) || (cp >= 0x06EA && cp <= 0x06ED) ||
            cp == 0x0E31 || (cp >= 0x0E34 && cp <= 0x0E3A) ||
            (cp >= 0x0E47 && cp <= 0x0E4E) || cp == 0x0EB1 ||
            (cp >= 0x0EB4 && cp <= 0x0EBC) || (cp >= 0x0EC8 && cp <= 0x0ECD) ||
            (cp >= 0x1AB0 && cp <= 0x1AC0) || (cp >= 0x1DC0 && cp <= 0x1DFF) ||
            (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x202A && cp <= 0x202E) ||
            (cp >= 0x2060 && cp <= 0x2064) || (cp >= 0x2066 && cp <= 0x206F) ||
            (cp >= 0x20D0 && cp <= 0x20F0) || (cp >= 0x302A && cp <= 0x302D) ||
            (cp >= 0x3099 && cp <= 0x309A) || (cp >= 0xFE00 && cp <= 0xFE0F) ||
            (cp >= 0xFE20 && cp <= 0xFE2F) || cp == 0xFEFF || cp == 0xE0001 ||
            (cp >= 0xE0020 && cp <= 0xE007F) ||
            (cp >= 0xE0100 && cp <= 0xE01EF) )); then w=0
    elif (( (cp >= 0x1100 && cp <= 0x115F) || (cp >= 0x231A && cp <= 0x231B) ||
            (cp >= 0x2329 && cp <= 0x232A) || (cp >= 0x23E9 && cp <= 0x23EC) ||
            cp == 0x23F0 || cp == 0x23F3 || (cp >= 0x25FD && cp <= 0x25FE) ||
            (cp >= 0x2614 && cp <= 0x2615) || (cp >= 0x2648 && cp <= 0x2653) ||
            cp == 0x267F || cp == 0x2693 || cp == 0x26A1 ||
            (cp >= 0x26AA && cp <= 0x26AB) || (cp >= 0x26BD && cp <= 0x26BE) ||
            (cp >= 0x26C4 && cp <= 0x26C5) || cp == 0x26CE || cp == 0x26D4 ||
            cp == 0x26EA || (cp >= 0x26F2 && cp <= 0x26F3) || cp == 0x26F5 ||
            cp == 0x26FA || cp == 0x26FD || cp == 0x2705 ||
            (cp >= 0x270A && cp <= 0x270B) || cp == 0x2728 || cp == 0x274C ||
            cp == 0x274E || (cp >= 0x2753 && cp <= 0x2755) || cp == 0x2757 ||
            (cp >= 0x2795 && cp <= 0x2797) || cp == 0x27B0 || cp == 0x27BF ||
            (cp >= 0x2B1B && cp <= 0x2B1C) || cp == 0x2B50 || cp == 0x2B55 ||
            (cp >= 0x2E80 && cp <= 0x303E) || (cp >= 0x3041 && cp <= 0x3247) ||
            (cp >= 0x3250 && cp <= 0x4DBF) || (cp >= 0x4E00 && cp <= 0xA4C6) ||
            (cp >= 0xA960 && cp <= 0xA97C) || (cp >= 0xAC00 && cp <= 0xD7A3) ||
            (cp >= 0xF900 && cp <= 0xFAD9) || (cp >= 0xFE10 && cp <= 0xFE19) ||
            (cp >= 0xFE30 && cp <= 0xFE6B) || (cp >= 0xFF01 && cp <= 0xFF60) ||
            (cp >= 0xFFE0 && cp <= 0xFFE6) || (cp >= 0x16FE0 && cp <= 0x16FE3) ||
            (cp >= 0x17000 && cp <= 0x1B2FB) || cp == 0x1F004 || cp == 0x1F0CF ||
            cp == 0x1F18E || (cp >= 0x1F191 && cp <= 0x1F19A) ||
            (cp >= 0x1F200 && cp <= 0x1F320) || (cp >= 0x1F32D && cp <= 0x1F393) ||
            (cp >= 0x1F3A0 && cp <= 0x1F3F0) || cp == 0x1F3F4 ||
            (cp >= 0x1F3F8 && cp <= 0x1F4FC) || (cp >= 0x1F4FF && cp <= 0x1F53D) ||
            (cp >= 0x1F54B && cp <= 0x1F54E) || (cp >= 0x1F550 && cp <= 0x1F567) ||
            cp == 0x1F57A || (cp >= 0x1F595 && cp <= 0x1F596) || cp == 0x1F5A4 ||
            (cp >= 0x1F5FB && cp <= 0x1F64F) || (cp >= 0x1F680 && cp <= 0x1F6C5) ||
            cp == 0x1F6CC || (cp >= 0x1F6D0 && cp <= 0x1F6D2) ||
            (cp >= 0x1F6D5 && cp <= 0x1F6D7) || (cp >= 0x1F6EB && cp <= 0x1F6EC) ||
            (cp >= 0x1F6F4 && cp <= 0x1F6FC) || (cp >= 0x1F7E0 && cp <= 0x1F7EB) ||
            (cp >= 0x1F90C && cp <= 0x1F9FF) || (cp >= 0x1FA70 && cp <= 0x1FAD6) ||
            (cp >= 0x20000 && cp <= 0x3134A) )); then w=2
    fi

    if (( lim >= 0 && ! cut_done )); then
      if (( D_W + w <= lim )); then D_CUT=$(( i + n )); D_CUTW=$(( D_W + w ))
      else cut_done=1; fi
    fi
    D_W=$(( D_W + w ))
    i=$(( i + n ))
  done
  return 0
}

# dfit STR — display width of STR in columns. → D_W
dfit() { _dwalk "$1" -1; }

# dtrunc STR COLS [ELLIPSIS] — STR cut to at most COLS columns, with ELLIPSIS
# appended when anything was dropped; pass "" (or nothing) for a hard cut. The
# cut always lands on a codepoint boundary, so a multibyte character is never
# halved and a two-column character straddling the edge is dropped rather than
# split — which can leave the result one column narrower than COLS. → D_S, D_W
dtrunc() {
  local LC_ALL=C s="$1" cols="$2" ell="${3-}" ellw=0 target
  _dwalk "$s" -1
  if (( D_W <= cols )); then D_S="$s"; return 0; fi
  if (( cols <= 0 )); then D_S=""; D_W=0; return 0; fi
  if [[ -n "$ell" ]]; then _dwalk "$ell" -1; ellw=$D_W; fi
  # Not enough room for the marker itself: cut hard rather than hand back
  # something wider than the budget, which would push the whole row out.
  if (( ellw >= cols )); then ell=""; ellw=0; fi
  target=$(( cols - ellw ))
  _dwalk "$s" "$target"
  D_S="${s:0:D_CUT}$ell"
  D_W=$(( D_CUTW + ellw ))
  return 0
}

# dcell STR COLS [ELLIPSIS] — dtrunc, then pad with spaces out to EXACTLY COLS
# columns. Every fixed-width cell in the table goes through this. → D_S, D_W
dcell() {
  local pad
  dtrunc "$1" "$2" "${3-}"
  pad=$(( $2 - D_W ))
  if (( pad > 0 )); then printf -v D_S '%s%*s' "$D_S" "$pad" ''; fi
  D_W=$2
  return 0
}

# Glyphs. GHA_ASCII=1 (or --ascii) swaps every non-ASCII mark for a plain
# equivalent, for terminal fonts with no symbol coverage: Monaco has none of
# these, not even ●, and SF Mono is missing the dotted circle. Every replacement
# is ONE column wide, like the glyph it stands in for, so a row's layout does
# not shift between the two modes.
[[ -n "${GHA_ASCII:-}" ]] && ascii=true
if $ascii; then
  I_OK='+'; I_BAD='x'; I_RUN='*'; I_QUEUE='o'; I_CANCEL='/'; I_SKIP='-'
  I_WATCH='@'; I_WAIT='@'; ELL='~'; SEP='.'; RULE='-'; DASH='-'
  PTR='>'; PICK='|'; ENTER='enter'
else
  I_OK='✓'; I_BAD='✗'; I_RUN='●'; I_QUEUE='○'; I_CANCEL='⊘'; I_SKIP='–'
  I_WATCH='⏱'; I_WAIT='⏳'; ELL='…'; SEP='·'; RULE='─'; DASH='—'
  PTR='▸'; PICK='▍'; ENTER='↵'
fi

# hlink URL TEXT — wrap TEXT in an OSC 8 hyperlink (plain TEXT when unsupported).
hlink() {
  if $use_links; then printf '\e]8;;%s\e\\%s\e]8;;\e\\' "$1" "$2"
  else printf '%s' "$2"; fi
}

# now_epoch — "now" as epoch seconds. Every clock in the rendering path reads
# it, so setting $GHA_NOW freezes all of them at once: relative ages, durations
# and the demo animation phase stop moving and a render becomes reproducible
# byte for byte. The test suite pins it; nothing else sets it. (It is separate
# from $GHA_DEMO_START, which anchors only the demo's running→passed cycle and
# must keep advancing for `gha --demo -L` to animate.)
now_epoch() { if [[ -n "${GHA_NOW:-}" ]]; then printf '%s' "$GHA_NOW"; else date -u "+%s"; fi; }

# rel TS — relative age of a UTC timestamp, e.g. "3m", "2h", "5d".
rel() {
  local ts now diff
  ts=$(iso_to_epoch "$1")
  now=$(now_epoch); diff=$(( now - ts )); (( diff < 0 )) && diff=0
  if   (( diff < 60 ));    then echo "${diff}s"
  elif (( diff < 3600 ));  then echo "$(( diff / 60 ))m"
  elif (( diff < 86400 )); then echo "$(( diff / 3600 ))h"
  else                          echo "$(( diff / 86400 ))d"; fi
}

# dur A B — duration between two UTC timestamps, e.g. "1m20s".
dur() {
  local a b diff
  a=$(iso_to_epoch "$1")
  b=$(iso_to_epoch "$2")
  diff=$(( b - a )); (( diff < 0 )) && diff=0
  if (( diff < 60 )); then echo "${diff}s"; else echo "$(( diff / 60 ))m$(( diff % 60 ))s"; fi
}

# live_elapsed TS — ticking elapsed since a UTC timestamp: "0:42", "12:03", "1h05".
# Used for in-progress runs so the seconds visibly advance in live view.
live_elapsed() {
  local s now d
  s=$(iso_to_epoch "$1")
  now=$(now_epoch); d=$(( now - s )); (( d < 0 )) && d=0
  if (( d < 3600 )); then printf '%d:%02d' $(( d / 60 )) $(( d % 60 ))
  else printf '%dh%02d' $(( d / 3600 )) $(( (d % 3600) / 60 )); fi
}

# demo_json — synthetic run data for --demo so the UX can be previewed without
# real CI. The Deploy run cycles running→passed every 30s (timer ticks 0:00→0:24,
# then shows "22s" briefly), alongside a success, a red failure, and a queued run.
#
# The last three rows are there for the layout, not the demo: a CJK branch name,
# an emoji-prefixed title, a title carrying ⚠️ (U+26A0 + VS16, which is one
# column and not two), an over-long branch and a title long enough to truncate at
# every supported width. Those are the inputs that tell a column measured in
# terminal columns apart from one measured in characters or bytes; the test
# suite asserts every row still lands on the layout width (see tests/README.md).
_iso() { epoch_to_iso "$1"; }
demo_json() {
  local start now cyc rcreated rstatus rconcl rupd
  now=$(now_epoch)
  start="${GHA_DEMO_START:-$now}"
  cyc=$(( (now - start) % 30 )); (( cyc < 0 )) && cyc=0
  rcreated="$(_iso $(( now - cyc )))"
  if (( cyc < 25 )); then rstatus='"in_progress"'; rconcl=null; rupd="\"$rcreated\""
  else rstatus='"completed"'; rconcl='"success"'; rupd="\"$(_iso $(( now - cyc + 22 )))\""; fi
  cat <<JSON
[
 {"databaseId":901,"name":"Deploy","headBranch":"develop","status":$rstatus,"conclusion":$rconcl,"displayTitle":"Production deploy (demo)","createdAt":"$rcreated","updatedAt":$rupd,"event":"workflow_run"},
 {"databaseId":902,"name":"CI","headBranch":"develop","status":"completed","conclusion":"success","displayTitle":"Make the runs table responsive at any width","createdAt":"$(_iso $(( now - 300 )))","updatedAt":"$(_iso $(( now - 52 )))","event":"push"},
 {"databaseId":903,"name":"CI","headBranch":"fix-flaky-test","status":"completed","conclusion":"failure","displayTitle":"Try to fix the flaky integration test again","createdAt":"$(_iso $(( now - 1800 )))","updatedAt":"$(_iso $(( now - 1705 )))","event":"pull_request"},
 {"databaseId":904,"name":"Lint","headBranch":"chore/bump-deps","status":"queued","conclusion":null,"displayTitle":"Bump dependencies to latest","createdAt":"$(_iso $(( now - 40 )))","updatedAt":"$(_iso $(( now - 40 )))","event":"pull_request"},
